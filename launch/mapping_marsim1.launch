<launch>
<!-- Launch file for Livox AVIA LiDAR -->
<group ns="uav1">	
	<arg name="rviz" default="true" />
	<node pkg="tf" type="static_transform_publisher" name="w2base" args="0 0 0 0 0 0 camera_init world 1000" />
	<rosparam command="load" file="$(find fast_lio)/config/marsim1.yaml" />

	<param name="feature_extract_enable" type="bool" value="0"/>
	<param name="point_filter_num" type="int" value="3"/>
	<param name="max_iteration" type="int" value="3" />
	<param name="filter_size_surf" type="double" value="0.2" />
	<param name="filter_size_map" type="double" value="0.3" />
	<param name="cube_side_length" type="double" value="1000" />
	<param name="runtime_pos_log_enable" type="bool" value="0" />
    <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen" />

	<!-- ICP 2D Registration Node -->
	<node pkg="fast_lio" type="icp_2d_registration.py" name="icp_2d_registration" output="screen">
		<param name="z_center" value="1.5" />
		<param name="z_tolerance" value="0.1" />
		<param name="max_points" value="5000" />
		<param name="window_size" value="10" />
		<param name="init_x" value="11.5" />
		<param name="init_y" value="4.5" />
		<param name="init_yaw" value="0.2" />
	</node>

	<group if="$(arg rviz)">
	<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_lio)/rviz_cfg/loam_livox.rviz" />
	</group>
</group>
</launch>
